# --- Temporal ---------------------------------------------------------------
# Local dev server (`npm run temporal` or docker compose) needs no auth.
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TASK_QUEUE=car-lease-onboarding
# Temporal Cloud: set the namespace endpoint + API key (TLS is enabled automatically).
# TEMPORAL_ADDRESS=my-ns.a1b2c.tmprl.cloud:7233
# TEMPORAL_NAMESPACE=my-ns.a1b2c
# TEMPORAL_API_KEY=...
# Force TLS without an API key (e.g. the dev server behind Azure Container Apps ingress)
# TEMPORAL_TLS=true

# --- Local database (written by the worker's activities) --------------------
DB_PATH=./data/leasing.db

# --- Mock external services --------------------------------------------------
MOCK_SERVICES_URL=http://localhost:8081
MOCK_PORT=8081
# Optional JSON override of the default chaos settings, e.g.
# MOCK_CHAOS={"creditBureau":{"failFirstN":4},"inventory":{"failureRate":0}}

# --- HTTP API ---------------------------------------------------------------
PORT=3000
# Public URL of the agent inbox, used in task links (shown in the Temporal UI)
# AGENT_PAGE_URL=http://localhost:3000/agent
