{
  "name": "car-lease-onboarding",
  "version": "0.1.0",
  "private": true,
  "description": "Temporal PoC: onboard car-lease customers from lead to signed leasing contract",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "temporal": "mkdir -p data && temporal server start-dev --db-filename data/temporal.db",
    "dev": "concurrently -n mocks,worker,api -c magenta,cyan,green \"npm:dev:mocks\" \"npm:dev:worker\" \"npm:dev:api\"",
    "dev:worker": "tsx watch src/temporal/worker.ts",
    "dev:api": "tsx watch src/api/server.ts",
    "dev:mocks": "tsx watch src/mock-services/server.ts",
    "start:worker": "node dist/temporal/worker.js",
    "start:api": "node dist/api/server.js",
    "start:mocks": "node dist/mock-services/server.js",
    "demo": "tsx src/demo/index.ts",
    "lead": "tsx src/scripts/start-onboarding.ts",
    "db:show": "tsx src/scripts/show-db.ts",
    "reset": "tsx src/scripts/reset-workflow.ts",
    "chaos": "tsx src/scripts/chaos.ts",
    "test": "tsx --test 'src/**/*.test.ts'",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@temporalio/activity": "^1.24.0",
    "@temporalio/client": "^1.24.0",
    "@temporalio/common": "^1.24.0",
    "@temporalio/worker": "^1.24.0",
    "@temporalio/workflow": "^1.24.0",
    "better-sqlite3": "^13.0.3",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@clack/prompts": "^1.8.1",
    "@temporalio/testing": "^1.24.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "concurrently": "^10.0.6",
    "picocolors": "^1.1.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  }
}
